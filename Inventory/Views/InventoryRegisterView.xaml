<UserControl x:Class="AMANC_Inventory.Views.InventoryRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Estilo para Convertir RadioButtons en Tarjetas Interactivas -->
        <Style x:Key="CardButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#102240"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="cardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#102240"/>
                    <Setter Property="BorderBrush" Value="#102240"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Moderno para TextBox -->
        <Style x:Key="ModernInputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Moderno para ComboBox -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Estilo de Contenedor Card -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Estilos Base Globales para Inputs -->
        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Selector de Módulo (4 Tarjetas) -->
            <RowDefinition Height="*"/>
            <!-- Contenedor Completo de Formularios -->
        </Grid.RowDefinitions>

        <!-- 1. SELECTOR DE MÓDULOS DE REGISTRO (4 Tarjetas Abarcando Todo el Ancho) -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,15">

            <!-- 1. Registro Producto -->
            <RadioButton Style="{StaticResource CardButtonStyle}" 
                         IsChecked="{Binding IsInventoryTabSelected, Mode=TwoWay, FallbackValue=True}"
                         Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Registrar Entrada" FontSize="10" FontWeight="SemiBold" Opacity="0.75"/>
                        <TextBlock Text="Producto / Stock" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </RadioButton>

            <!-- 2. Registro Donación -->
            <RadioButton Style="{StaticResource CardButtonStyle}" 
                         IsChecked="{Binding IsDonationsTabSelected, Mode=TwoWay}"
                         Margin="3,0,3,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Registrar Entrada" FontSize="10" FontWeight="SemiBold" Opacity="0.75"/>
                        <TextBlock Text="Donación" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </RadioButton>

            <!-- 3. Registro Beneficiario -->
            <RadioButton Style="{StaticResource CardButtonStyle}" 
                         IsChecked="{Binding IsPatientsTabSelected, Mode=TwoWay}"
                         Margin="3,0,3,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Registrar Beneficiario" FontSize="10" FontWeight="SemiBold" Opacity="0.75"/>
                        <TextBlock Text="Niño / Tutor" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </RadioButton>

            <!-- 4. Registro Traslado -->
            <RadioButton Style="{StaticResource CardButtonStyle}" 
                         IsChecked="{Binding IsTripsTabSelected, Mode=TwoWay}"
                         Margin="6,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE709;" FontFamily="Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Registrar Solicitud" FontSize="10" FontWeight="SemiBold" Opacity="0.75"/>
                        <TextBlock Text="Traslado / Viaje" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </RadioButton>

        </UniformGrid>

        <!-- 2. CONTENEDOR DE FORMULARIOS -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="25,20,25,20">
                <Grid>

                    <!-- ============================================================== -->
                    <!-- FORMULARIO 1: PRODUCTO / STOCK -->
                    <!-- ============================================================== -->
                    <Grid Visibility="{Binding IsInventoryTabSelected, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!-- SECCIÓN 1: Identificación y Clasificación -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="IDENTIFICACIÓN Y CLASIFICACIÓN" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="SKU (Código Interno)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewSKU, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Código de Barras" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewBarcode, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="Nombre del Producto *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Categoría" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding CategoriesList}" SelectedItem="{Binding NewCategory}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Sede Asignada" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewBranchId}" IsReadOnly="True" Focusable="False" Background="#F1F5F9" Foreground="#64748B"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="Estatus del Registro" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding StatusList}" SelectedItem="{Binding NewStatus}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 2: Control de Existencias y Logística -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE1D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="CONTROL DE EXISTENCIAS Y LOGÍSTICA" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Stock Inicial *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewStock, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Stock Mínimo (Alerta)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewMinStock, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="Unidad de Medida" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding UnitsList}" SelectedItem="{Binding NewUnit}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel>
                                        <TextBlock Text="Ubicación Física en Almacén" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewLocation, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 3: Datos Financieros y Condición -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="VALORES Y CONDICIÓN" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Valor Estimado Unitario ($)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewEstimatedValue, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Fecha de Caducidad" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <DatePicker SelectedDate="{Binding NewExpirationDate}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Margin="10,0,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding NewIsDonated}" VerticalAlignment="Center" Cursor="Hand"/>
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock Text="¿Es Insumo Donado?" FontSize="12" FontWeight="Bold" Foreground="#102240"/>
                                                    <TextBlock Text="Marca para contabilidad fiscal" FontSize="10" Foreground="#64748B"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Botón Guardar Producto -->
                        <Button Grid.Row="1"
                                Command="{Binding SaveItemCommand}" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Bottom"
                                Margin="0,10,0,0" 
                                Padding="24,12" 
                                Background="#102240" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="13"
                                BorderThickness="0" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Guardar en Inventario" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ============================================================== -->
                    <!-- FORMULARIO 2: DONACIONES -->
                    <!-- ============================================================== -->
                    <Grid Visibility="{Binding IsDonationsTabSelected, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!-- SECCIÓN 1: Información del Donante -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="INFORMACIÓN DEL DONANTE" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Empresa / Donante *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewDonorCompany, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Tipo de Donante" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding DonorTypesList}" SelectedItem="{Binding NewDonorType}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="Fecha de Recepción" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <DatePicker SelectedDate="{Binding NewDonationDate}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 2: Detalle del Insumo Donado -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="DETALLE DEL INSUMO DONADO" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Producto Donado *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewDonatedProduct, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Presentación" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewPresentation, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="Cantidad Recibida" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewDonationQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 3: Valuación y Comprobantes -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="VALUACIÓN Y COMPROBANTES" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Valor Estimado Unitario ($)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewUnitPrice, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Folio de Recibo Deducible / Documento" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewReceiptFolio, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Botón Guardar Donación -->
                        <Button Grid.Row="1"
                                Command="{Binding SaveDonationCommand}" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Bottom"
                                Margin="0,10,0,0" 
                                Padding="24,12" 
                                Background="#102240" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="13"
                                BorderThickness="0" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Guardar Donación" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ============================================================== -->
                    <!-- FORMULARIO 3: BENEFICIARIOS / NIÑOS -->
                    <!-- ============================================================== -->
                    <Grid Visibility="{Binding IsPatientsTabSelected, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!-- SECCIÓN 1: Datos del Beneficiario y Diagnóstico -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="DATOS DEL BENEFICIARIO Y DIAGNÓSTICO" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Nombre del Beneficiario *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewChildName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Edad" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewAge, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="CURP" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewCurp, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel>
                                        <TextBlock Text="Diagnóstico / Tipo de Cáncer *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewCancerType, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 2: Tutor y Contacto -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7C3AED" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="TUTOR E INFORMACIÓN DE CONTACTO" FontSize="11" FontWeight="Bold" Foreground="#7C3AED"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Tutor / Responsable" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewGuardians, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Parentesco" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewRelationship, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="Teléfono(s) de Contacto" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewPhones, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 3: Ubicación y Residencia -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="UBICACIÓN Y RESIDENCIA" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Ciudad" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewCity, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Estado" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewState, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Botón Guardar Beneficiario -->
                        <Button Grid.Row="1"
                                Command="{Binding SavePatientCommand}" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Bottom"
                                Margin="0,10,0,0" 
                                Padding="24,12" 
                                Background="#102240" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="13"
                                BorderThickness="0" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Guardar Beneficiario" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ============================================================== -->
                    <!-- FORMULARIO 4: TRASLADOS / VIAJES -->
                    <!-- ============================================================== -->
                    <Grid Visibility="{Binding IsTripsTabSelected, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!-- SECCIÓN 1: Pasajeros y Asignación -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="PASAJEROS Y ASIGNACIÓN" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Nombre del Beneficiario *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewTripChild, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Acompañante / Tutor" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewTripGuardian, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 2: Ruta y Medio de Transporte -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE709;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="RUTA Y MEDIO DE TRANSPORTE" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Origen *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewOrigin, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Destino *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding NewDestination, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="Medio de Transporte" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding TransportTypesList}" SelectedItem="{Binding NewTransportType}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 3: Programación y Estatus -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xEC92;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="PROGRAMACIÓN Y ESTATUS" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Fecha de Salida" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <DatePicker SelectedDate="{Binding NewDepartureDate}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                            <TextBlock Text="Fecha de Regreso / Estimada" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <DatePicker SelectedDate="{Binding NewReturnDate}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="Estatus del Viaje" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding TripStatusList}" SelectedItem="{Binding NewTripStatus}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Botón Guardar Traslado -->
                        <Button Grid.Row="1"
                                Command="{Binding SaveTripCommand}" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Bottom"
                                Margin="0,10,0,0" 
                                Padding="24,12" 
                                Background="#102240" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="13"
                                BorderThickness="0" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Guardar Traslado" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>