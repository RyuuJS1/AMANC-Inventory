<UserControl x:Class="AMANC_Inventory.Views.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Border Background="#102240" Padding="15,10">
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/LogoAMANC.png" Width="40" Height="32" Margin="0,0,10,0"/>
                <TextBlock Text="Sistema de Inventarios AMANC" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Botón de Perfil Clickeable -->
            <Button Command="{Binding AbrirPerfilCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="5,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NombreUsuario, FallbackValue='Usuario'}" Foreground="White" FontSize="14" Margin="0,9,10,0"/>
                                <Grid Width="34" Height="34">
                                    <!-- Opción 1: Iniciales (Si NO tiene foto) -->
                                    <Border CornerRadius="17" Background="#183059" BorderBrush="White" BorderThickness="1.5"
                                            Visibility="{Binding HasNoProfilePicture, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="{Binding UserInitials, FallbackValue='U'}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Opción 2: Imagen (Si SÍ tiene foto) -->
                                    <Ellipse Stroke="White" StrokeThickness="1.5" Visibility="{Binding HasProfilePicture, Converter={StaticResource BoolToVisConverter}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ProfileImageSource}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>