<UserControl x:Class="AMANC_Inventory.Views.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Border Background="#102240" Padding="15,10">
        <Grid>
            <!-- Logo y Título -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/LogoAMANC.png" Width="40" Height="32" Margin="0,0,10,0"/>
                <TextBlock Text="Sistema de Inventarios AMANC" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Botón de Perfil Clickeable -->
            <Button Command="{Binding AbrirPerfilCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="5,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Nombre del usuario -->
                                <TextBlock Text="{Binding CurrentUser.Name, FallbackValue='Usuario'}" Foreground="White" FontSize="14" Margin="0,9,10,0"/>

                                <Grid Width="34" Height="34">
                                    <!-- Opción 1: Iniciales (Si NO tiene foto) -->
                                    <Border CornerRadius="17" 
                                            Background="#183059" 
                                            BorderBrush="White" 
                                            BorderThickness="1.5"
                                            Visibility="{Binding CurrentUser.HasNoProfilePicture, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="{Binding CurrentUser.UserInitials, FallbackValue='U'}" 
                                                   Foreground="White" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Opción 2: Imagen Circular (Si SÍ tiene foto) -->
                                    <Ellipse Width="34" 
                                             Height="34" 
                                             Stroke="White" 
                                             StrokeThickness="1.5"
                                             Visibility="{Binding CurrentUser.HasProfilePicture, Converter={StaticResource BoolToVisConverter}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding CurrentUser.ProfileImageSource}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>