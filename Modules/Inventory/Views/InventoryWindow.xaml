<Window x:Class="AMANC_Inventory.Views.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AMANC_Inventory.Views"
        Title="AMANC Inventory"
        Height="700" Width="950"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. ENCABEZADO PRINCIPAL -->
            <views:HeaderControl Grid.Row="0"/>

            <!-- 2. ZONA PRINCIPAL DE CONTENIDO -->
            <Grid Grid.Row="1">

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProfileDetailsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de Pestañas de Navegación Principal -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
                        <StackPanel Orientation="Horizontal">

                            <!-- Pestaña 0: Consultas -->
                            <Button Content="📦 Consultas" 
                                    Command="{Binding SelectMainTabCommand}" 
                                    CommandParameter="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                                <Setter Property="Foreground" Value="#102240"/>
                                                <Setter Property="BorderBrush" Value="#102240"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Pestaña 1: Registros -->
                            <Button Content="➕ Registros" 
                                    Command="{Binding SelectMainTabCommand}" 
                                    CommandParameter="1">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                                <Setter Property="Foreground" Value="#102240"/>
                                                <Setter Property="BorderBrush" Value="#102240"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                    </Border>

                    <!-- Vistas Internas (Inheritan DataContext de InventoryViewModel) -->
                    <Grid Grid.Row="1" Margin="20">
                        <!-- Vista 1: Consultar Inventario -->
                        <views:InventoryConsultView 
                            Visibility="{Binding IsTabConsultVisible, Converter={StaticResource BoolToVisConverter}}"/>

                        <!-- Vista 2: Registrar Nuevo Artículo -->
                        <views:InventoryRegisterView 
                            Visibility="{Binding IsTabRegisterVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>
                </Grid>

                <!-- MÓDULO DE PERFIL DE USUARIO -->
                <views:UserProfileView x:Name="UserProfileViewControl" 
                                       Visibility="{Binding IsProfileDetailsOpen, Converter={StaticResource BoolToVisConverter}}" />

            </Grid>
        </Grid>
    </Grid>
</Window>