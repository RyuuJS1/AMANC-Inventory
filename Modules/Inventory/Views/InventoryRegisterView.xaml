<UserControl x:Class="AMANC_Inventory.Views.InventoryRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:AMANC_Inventory.Inventory.Views.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Selector de Módulo (5 Tarjetas) -->
            <RowDefinition Height="*"/>
            <!-- Contenedor Completo de Formularios -->
        </Grid.RowDefinitions>

        <!-- 1. SELECTOR DE MÓDULOS DE REGISTRO (MODULAR) -->
        <controls:RegisterSubTabSelectorControl Grid.Row="0"/>

        <!-- 2. CONTENEDOR DE FORMULARIOS -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="25,20,25,20">
                <Grid>
                    <!-- FORMULARIO 1: PRODUCTO / STOCK -->
                    <controls:ProductRegisterFormControl 
                        Visibility="{Binding IsInventoryTabSelected, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- FORMULARIO 2: DESPENSAS Y ENTREGAS -->
                    <controls:PantryRegisterFormControl 
                        Visibility="{Binding IsPantriesTabSelected, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- FORMULARIO 3: DONACIONES -->
                    <controls:DonationRegisterFormControl 
                        Visibility="{Binding IsDonationsTabSelected, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- FORMULARIO 4: BENEFICIARIOS -->
                    <controls:PatientRegisterFormControl 
                        Visibility="{Binding IsPatientsTabSelected, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- FORMULARIO 5: TRASLADOS Y VIAJES -->
                    <controls:TripRegisterFormControl 
                        Visibility="{Binding IsTripsTabSelected, Converter={StaticResource BoolToVisConverter}}"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>