<UserControl x:Class="AMANC_Inventory.Inventory.Views.Controls.DonationRegisterFormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="ModernInputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsDonationsTabSelected, Converter={StaticResource BoolToVisConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.Row="0">
                <!-- SECCIÓN 1: Información del Donante -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="INFORMACIÓN DEL DONANTE" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Empresa / Donante *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding DonationRegister.NewDonorCompany, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                <TextBlock Text="Tipo de Donante" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding DonationRegister.DonorTypesList}" SelectedItem="{Binding DonationRegister.NewDonorType}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="5,0,5,0">
                                <TextBlock Text="Fecha de Recepción" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding DonationRegister.NewDonationDate}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="Folio Recibo Deducible" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding DonationRegister.NewReceiptFolio, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECCIÓN 2: Buscador y Selección de Productos Existentes -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="BUSCAR Y ASOCIAR PRODUCTOS EXISTENTES" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Buscador Desplegable de Productos con Nombre Permanente -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Seleccionar Producto Registrado *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource ModernComboBoxStyle}" 
                                    ItemsSource="{Binding DonationRegister.FilteredProductsList}"
                                    SelectedItem="{Binding DonationRegister.SelectedProduct}"
                                    IsEditable="True"
                                    TextSearch.TextPath="Name"
                                    Text="{Binding DonationRegister.ProductSearchText, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text=" - SKU: " Foreground="#64748B"/>
                                                <TextBlock Text="{Binding SKU}" Foreground="#2563EB" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Entrada de Cantidad (Se carga automáticamente desde el producto) -->
                            <StackPanel Grid.Column="3" Margin="4,0,8,0">
                                <TextBlock Text="Cantidad" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernInputStyle}" 
                                    Text="{Binding DonationRegister.TempQuantity}" 
                                    IsReadOnly="True" 
                                    Focusable="False" 
                                    Background="#F1F5F9" 
                                    Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Datos Automáticos Cargaros del Producto Seleccionado -->
                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                <TextBlock Text="Unidad" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding DonationRegister.TempPresentation}" IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="4,0,8,0">
                                <TextBlock Text="Valor Unitario" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding DonationRegister.TempUnitPrice}" IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Entrada de Cantidad Donada -->
                            <StackPanel Grid.Column="3" Margin="4,0,8,0">
                                <TextBlock Text="Cantidad *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernInputStyle}" Text="{Binding DonationRegister.TempQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Button Grid.Column="4" Command="{Binding DonationRegister.AddItemCommand}"
                                    Content="+ Añadir a Donación" Background="#059669" Foreground="White" FontWeight="Bold" 
                                    Padding="14,0" Height="36" VerticalAlignment="Bottom" Cursor="Hand" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Tabla de Insumos Seleccionados -->
                        <DataGrid ItemsSource="{Binding DonationRegister.DonationItemsList}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True" Height="150" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID Prod." Binding="{Binding ProductId}" Width="80"/>
                                <DataGridTextColumn Header="Producto Seleccionado" Binding="{Binding ProductName}" Width="2*"/>
                                <DataGridTextColumn Header="Unidad" Binding="{Binding Presentation}" Width="80"/>
                                <DataGridTextColumn Header="Cantidad Donada" Binding="{Binding Quantity}" Width="110"/>
                                <DataGridTextColumn Header="Precio Unitario" Binding="{Binding UnitPrice, StringFormat=\{0:C\}}" Width="110"/>
                                <DataGridTextColumn Header="Total Estimado" Binding="{Binding TotalAmount, StringFormat=\{0:C\}}" Width="110"/>
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Quitar" Foreground="#EF4444" FontWeight="Bold" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding DataContext.DonationRegister.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding DonationRegister.TotalDonationAmount, StringFormat='Monto Total Estimado de la Donación: \{0:C\}'}" 
                                   HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#102240" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botón Guardar Donación -->
        <Button Grid.Row="1" Command="{Binding DonationRegister.SaveDonationCommand}" 
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,10,0,0" Padding="24,12" Background="#102240" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Registrar Donación" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>