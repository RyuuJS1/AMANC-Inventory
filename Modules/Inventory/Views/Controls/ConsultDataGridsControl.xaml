<UserControl x:Class="AMANC_Inventory.Inventory.Views.Controls.ConsultDataGridsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- ESTILO PARA CENTRAR TODA LA INFORMACIÓN DE LAS CELDAS Y DAR PADDING -->
        <Style x:Key="CenterTextColumn" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ESTILO GLOBAL DATAGRID: AUTO-AJUSTE DE COLUMNAS Y DESPLAZAMIENTO FLUIDO -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="ColumnWidth" Value="Auto"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="36"/>

            <!-- DIFERENCIACIÓN DE FILAS -->
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>

            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>

            <!-- PERMITE QUE EL DATAGRID MIDA SU ANCHO REAL Y HABILITE EL SCROLL HORIZONTAL EXTERNO -->
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>

            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        </Style>
    </UserControl.Resources>

    <!-- CONTENEDOR CON BARRA HORIZONTAL EXTERNA Y MINWIDTH ADAPTATIVO -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Disabled"
                  Focusable="False">
        <Grid HorizontalAlignment="Left" 
              VerticalAlignment="Stretch"
              MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- TABLA 1: PRODUCTOS -->
            <DataGrid ItemsSource="{Binding ProductConsult.FilteredItems}" 
                      Visibility="{Binding IsInventoryTabSelected, Converter={StaticResource BoolToVisConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Cód. Barras" Binding="{Binding Barcode}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Nombre del Producto" Binding="{Binding Name}" Width="Auto" MinWidth="180" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding MinStock}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Valor Estimado" Binding="{Binding EstimatedValue, StringFormat=\{0:C\}}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTemplateColumn Header="¿Donado?" Width="Auto" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✘"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDonated}" Value="True">
                                                    <Setter Property="Text" Value="✔"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ubicación" Binding="{Binding Location}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Estatus" Binding="{Binding Status}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Fecha Caducidad" Binding="{Binding ExpirationDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Fecha Creación" Binding="{Binding CreatedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Última Actualización" Binding="{Binding UpdatedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource CenterTextColumn}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- TABLA 2: DESPENSAS -->
            <DataGrid ItemsSource="{Binding PantryConsult.FilteredPantriesList}" 
                      Visibility="{Binding IsPantriesTabSelected, Converter={StaticResource BoolToVisConverter}}"
                      RowHeight="NaN"
                      MinRowHeight="36">
                <DataGrid.Columns>
                    <!-- Folio -->
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Destino / Beneficiario -->
                    <DataGridTextColumn Header="Destino / Beneficiario" Binding="{Binding Destination}" Width="Auto" MinWidth="160" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Despliegue Multiproducto de Insumos -->
                    <DataGridTemplateColumn Header="Productos Entregados (Insumo | Cantidad | P.U. | Subtotal)" Width="Auto" MinWidth="340">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="8,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Foreground="#0F172A" FontSize="12"/>
                                                <TextBlock Text=" — " Foreground="#64748B" FontSize="12"/>
                                                <TextBlock Text="{Binding Quantity}" FontWeight="Bold" Foreground="#2563EB" FontSize="12"/>
                                                <TextBlock Text=" " FontSize="12"/>
                                                <TextBlock Text="{Binding Unit}" Foreground="#64748B" FontSize="11"/>
                                                <TextBlock Text=" x " Foreground="#64748B" FontSize="11"/>
                                                <TextBlock Text="{Binding UnitPrice, StringFormat=\{0:C\}}" Foreground="#475569" FontSize="11"/>
                                                <TextBlock Text=" = " Foreground="#64748B" FontSize="11"/>
                                                <TextBlock Text="{Binding Subtotal, StringFormat=\{0:C\}}" FontWeight="Bold" Foreground="#059669" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Monto Total Estimado -->
                    <DataGridTextColumn Header="Total Estimado" Binding="{Binding TotalAmount, StringFormat=\{0:C\}}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Fecha Entrega -->
                    <DataGridTextColumn Header="Fecha Entrega" Binding="{Binding DeliveryDate, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Entregado Por -->
                    <DataGridTextColumn Header="Entregado Por" Binding="{Binding DeliveredBy}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Notas -->
                    <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="Auto" MinWidth="160" ElementStyle="{StaticResource CenterTextColumn}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- TABLA 3: DONACIONES MULTIPRODUCTO EN LISTA -->
            <DataGrid ItemsSource="{Binding DonationConsult.FilteredDonationsList}" 
                      Visibility="{Binding IsDonationsTabSelected, Converter={StaticResource BoolToVisConverter}}"
                      RowHeight="NaN"
                      MinRowHeight="36">
                <DataGrid.Columns>
                    <!-- ID -->
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Folio Recibo Deducible -->
                    <DataGridTextColumn Header="Folio" Binding="{Binding ReceiptFolio}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Empresa / Donante -->
                    <DataGridTextColumn Header="Donante" Binding="{Binding CompanyName}" Width="Auto" MinWidth="180" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Tipo de Donante -->
                    <DataGridTextColumn Header="Tipo Donante" Binding="{Binding DonorType}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Fecha -->
                    <DataGridTextColumn Header="Fecha" Binding="{Binding DonationDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Productos y detalles en lista vertical -->
                    <DataGridTemplateColumn Header="Productos y Detalles (Presentación | Cantidad | P.U. | Subtotal)" Width="Auto" MinWidth="380">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="8,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedDetail}" FontSize="12" Foreground="#334155" HorizontalAlignment="Left" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Monto Total -->
                    <DataGridTextColumn Header="Monto Total" Binding="{Binding TotalDonation, StringFormat=\{0:C\}}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterTextColumn}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- TABLA 4: BENEFICIARIOS -->
            <DataGrid ItemsSource="{Binding PatientConsult.FilteredPatientsList}" 
                      Visibility="{Binding IsPatientsTabSelected, Converter={StaticResource BoolToVisConverter}}"
                      RowHeight="NaN"
                      MinRowHeight="36">
                <DataGrid.Columns>
                    <!-- ID -->
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Nombre del Niño -->
                    <DataGridTextColumn Header="Nombre del Niño" Binding="{Binding ChildName}" Width="Auto" MinWidth="180" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Edad -->
                    <DataGridTextColumn Header="Edad" Binding="{Binding Age}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- CURP -->
                    <DataGridTextColumn Header="CURP" Binding="{Binding Curp}" Width="Auto" MinWidth="150" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Tipo de Cáncer -->
                    <DataGridTextColumn Header="Tipo de Cáncer" Binding="{Binding CancerType}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Despliegue Dinámico de Lista de Tutores y Contacto -->
                    <DataGridTemplateColumn Header="Tutores y Contacto (Nombre | Parentesco | Teléfono | Correo)" Width="Auto" MinWidth="340">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Guardians}" Margin="8,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#0F172A" FontSize="12"/>
                                                <TextBlock Text=" (" Foreground="#64748B" FontSize="12"/>
                                                <TextBlock Text="{Binding Relationship}" Foreground="#2563EB" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Text=") — Tel: " Foreground="#64748B" FontSize="12"/>
                                                <TextBlock Text="{Binding Phone}" FontWeight="Bold" Foreground="#059669" FontSize="12"/>
                                                <TextBlock Text="{Binding Email, StringFormat=' — \{0\}'}" Foreground="#64748B" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Ciudad -->
                    <DataGridTextColumn Header="Ciudad" Binding="{Binding City}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Estado -->
                    <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Estatus del Registro -->
                    <DataGridTextColumn Header="Estatus" Binding="{Binding Status}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource CenterTextColumn}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- TABLA 5: TRASLADOS -->
            <DataGrid ItemsSource="{Binding TripConsult.FilteredTripsList}" 
                      Visibility="{Binding IsTripsTabSelected, Converter={StaticResource BoolToVisConverter}}"
                      RowHeight="NaN"
                      MinRowHeight="36">
                <DataGrid.Columns>
                    <!-- ID -->
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Paciente / Niño -->
                    <DataGridTextColumn Header="Paciente / Niño" Binding="{Binding ChildName}" Width="Auto" MinWidth="180" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Responsable -->
                    <DataGridTextColumn Header="Responsable" Binding="{Binding GuardianName}" Width="Auto" MinWidth="150" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Origen -->
                    <DataGridTextColumn Header="Origen" Binding="{Binding Origin}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Destino -->
                    <DataGridTextColumn Header="Destino" Binding="{Binding Destination}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Medio de Transporte -->
                    <DataGridTextColumn Header="Transporte" Binding="{Binding TransportType}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Fecha Salida -->
                    <DataGridTextColumn Header="Fecha Salida" Binding="{Binding DepartureDate, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Fecha Estimada de Regreso -->
                    <DataGridTextColumn Header="Fecha Regreso" Binding="{Binding ArrivalDate, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource CenterTextColumn}"/>

                    <!-- Estatus del Traslado -->
                    <DataGridTextColumn Header="Estatus" Binding="{Binding Status}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource CenterTextColumn}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- TABLA 6: USUARIOS -->
            <DataGrid ItemsSource="{Binding UserConsult.FilteredUsersList}" 
                      Visibility="{Binding IsUsersTabSelected, Converter={StaticResource BoolToVisConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="Auto" MinWidth="180" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="Auto" MinWidth="180" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterTextColumn}"/>
                    <DataGridTextColumn Header="Rol / Permiso" Binding="{Binding Role}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource CenterTextColumn}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ScrollViewer>
</UserControl>