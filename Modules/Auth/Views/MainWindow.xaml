<Window x:Class="AMANC_Inventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AMANC_Inventory.Modules.Auth.Views.Controls"
        Title="AMANC Inventory - Acceso" 
        Height="620" Width="850"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#102240">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <!-- GRID RAÍZ PRINCIPAL -->
    <Grid>
        <!-- VIEWBOX PRINCIPAL: Escala únicamente la interfaz del formulario -->
        <Viewbox Stretch="Uniform">
            <Grid Width="800" Height="620">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ENCABEZADO Y PESTAÑAS (MODULAR) -->
                <controls:AuthHeaderControl Grid.Row="0"/>

                <!-- CONTENIDO DEL FORMULARIO -->
                <Grid Grid.Row="1" Width="300" HorizontalAlignment="Center" Margin="0,10,0,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- Campo Nombre Completo (Solo visible en Modo Registro) -->
                        <StackPanel Name="PanelNombre" Visibility="{Binding EsModoRegistro, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,12">
                            <TextBlock Text="Nombre Completo" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                            <TextBox Name="TxtNombre" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Background="#183059" Foreground="White" BorderBrush="White" BorderThickness="1" Padding="6" CaretBrush="White"/>
                        </StackPanel>

                        <!-- Campo Correo Electrónico (Sin Espacios y Minúsculas) -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Correo Electrónico" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                            <TextBox Name="TxtEmail" 
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#183059" Foreground="White" BorderBrush="White" BorderThickness="1" Padding="6" CaretBrush="White"
                                     PreviewKeyDown="TxtEmail_PreviewKeyDown"
                                     PreviewTextInput="TxtEmail_PreviewTextInput"/>
                        </StackPanel>

                        <!-- Campo Contraseña -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Contraseña" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                            <PasswordBox Name="TxtPassword" Background="#183059" Foreground="White" BorderBrush="White" BorderThickness="1" Padding="6" CaretBrush="White" PasswordChanged="TxtPassword_PasswordChanged"/>

                            <TextBlock Name="TxtNivelSeguridad" Text="{Binding NivelSeguridadTexto}" Foreground="{Binding NivelSeguridadColor}" Visibility="{Binding NivelSeguridadVisible, Converter={StaticResource BoolToVisConverter}}" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <!-- Enlace ¿Olvidaste tu contraseña? (Solo en Modo Login) -->
                            <Button Name="BtnForgotPassword" Content="¿Olvidaste tu contraseña?" Command="{Binding ForgotPasswordCommand}"
                                    Visibility="{Binding EsModoLogin, Converter={StaticResource BoolToVisConverter}}"
                                    Foreground="#80FFFFFF" Background="Transparent" BorderThickness="0" 
                                    FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Campo Confirmar Contraseña (Solo en Modo Registro) -->
                        <StackPanel Name="PanelConfirmarPassword" Visibility="{Binding EsModoRegistro, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,12">
                            <TextBlock Text="Confirmar Contraseña" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                            <PasswordBox Name="TxtConfirmPassword" Background="#183059" Foreground="White" BorderBrush="White" BorderThickness="1" Padding="6" CaretBrush="White" PasswordChanged="TxtConfirmPassword_PasswordChanged"/>
                            <TextBlock Name="TxtCoincidenciaPassword" Text="{Binding CoincidenciaPasswordTexto}" Foreground="{Binding CoincidenciaPasswordColor}" Visibility="{Binding CoincidenciaPasswordVisible, Converter={StaticResource BoolToVisConverter}}" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Botón Principal -->
                    <Button Name="BtnAccionPrincipal" Grid.Row="2" Content="{Binding TextoBotonPrincipal}" Command="{Binding SubmitCommand}" Background="#183059" Foreground="White" FontSize="15" FontWeight="SemiBold" BorderBrush="White" BorderThickness="2" Padding="12,6" Cursor="Hand" HorizontalAlignment="Center" Width="180"/>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- PANEL FLOTANTE DE CÓDIGO (MODULAR) -->
        <controls:OtpNotificationControl />
    </Grid>
</Window>