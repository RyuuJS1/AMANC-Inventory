<Window x:Class="AMANC_Inventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AMANC_Inventory.Modules.Auth.Views.Controls"
        Title="AMANC Inventory - Acceso" 
        Height="660" Width="850"
        MinHeight="560" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#102240">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- ESTILO PARA EL THUMB DEL SCROLLBAR (REDONDEADO Y SEMITRANSPARENTE) -->
        <Style x:Key="ModernScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="border" 
                                CornerRadius="4" 
                                Background="#33FFFFFF" 
                                Width="6" 
                                HorizontalAlignment="Right"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#66FFFFFF"/>
                                <Setter TargetName="border" Property="Width" Value="8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#99FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO GLOBAL PARA SCROLLBAR -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO ELEGANTE PARA ETIQUETAS DE CAMPOS (TEXTBLOCK) -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- BOTÓN PRINCIPAL (MÁS ESTRECHO QUE LOS CAMPOS: 180PX) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#183059"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E3A6E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#122545"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO DARK SUAVE CON BORDES REDONDEADOS PARA TEXTBOX -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#183059"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C3868"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C3868"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO DARK SUAVE CON BORDES REDONDEADOS PARA PASSWORDBOX -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#183059"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C3868"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C3868"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO DARK SUAVE CON BORDES REDONDEADOS PARA COMBOBOX -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#183059"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Border" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <ContentPresenter Grid.Column="0" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <ToggleButton Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" MinWidth="{Binding ActualWidth, ElementName=MainGrid}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#102240" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1C3868"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#102240"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C3868"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#183059"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- GRID RAÍZ PRINCIPAL -->
    <Grid>
        <!-- VIEWBOX PRINCIPAL -->
        <Viewbox Stretch="Uniform">
            <Grid Width="800" Height="630">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ENCABEZADO Y PESTAÑAS -->
                <controls:AuthHeaderControl Grid.Row="0" Margin="0,20,0,5"/>

                <!-- CONTENIDO DEL FORMULARIO EN UNA COLUMNA CENTRADA -->
                <ScrollViewer Grid.Row="1" 
                              VerticalAlignment="Top" 
                              MaxHeight="480"
                              Margin="0,10,0,35" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">

                    <!-- CAMPOS CON ANCHO REDUCIDO A 300PX -->
                    <StackPanel Width="300" HorizontalAlignment="Center" Margin="0,5,0,10">

                        <!-- 1. Nombre Completo (Solo Registro) -->
                        <StackPanel Name="PanelNombre" Margin="0,0,0,16" 
                                    Visibility="{Binding EsModoRegistro, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Nombre Completo" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Name="TxtNombre" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- 2. Correo Electrónico (Login y Registro) -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Correo Electrónico" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Name="TxtEmail" 
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                     PreviewKeyDown="TxtEmail_PreviewKeyDown"
                                     PreviewTextInput="TxtEmail_PreviewTextInput"/>
                        </StackPanel>

                        <!-- 3. Número de Teléfono (Solo Registro) -->
                        <StackPanel Margin="0,0,0,16" 
                                    Visibility="{Binding EsModoRegistro, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Teléfono" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Name="TxtPhone"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" 
                                     GotFocus="TxtPhone_GotFocus"
                                     TextChanged="TxtPhone_TextChanged"/>
                        </StackPanel>

                        <!-- 4. Sede / Sucursal (Solo Registro) -->
                        <StackPanel Margin="0,0,0,16" 
                                    Visibility="{Binding EsModoRegistro, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Sede / Sucursal" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding Branch, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- 5. Departamento (Solo Registro) -->
                        <StackPanel Margin="0,0,0,16" 
                                    Visibility="{Binding EsModoRegistro, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Departamento" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding Department, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- 6. Contraseña (Login y Registro) -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Contraseña" Style="{StaticResource FormLabelStyle}"/>
                            <PasswordBox Name="TxtPassword" PasswordChanged="TxtPassword_PasswordChanged"/>

                            <TextBlock Name="TxtNivelSeguridad" 
                                       Text="{Binding NivelSeguridadTexto}" 
                                       Foreground="{Binding NivelSeguridadColor}" 
                                       Visibility="{Binding NivelSeguridadVisible, Converter={StaticResource BoolToVisConverter}}" 
                                       FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <!-- Enlace ¿Olvidaste tu contraseña? (Solo Login) -->
                            <Button Name="BtnForgotPassword" Content="¿Olvidaste tu contraseña?" Command="{Binding ForgotPasswordCommand}"
                                    Visibility="{Binding EsModoLogin, Converter={StaticResource BoolToVisConverter}}"
                                    Foreground="#94A3B8" Background="Transparent" BorderThickness="0" 
                                    FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- 7. Confirmar Contraseña (Solo Registro) -->
                        <StackPanel Name="PanelConfirmarPassword" Margin="0,0,0,16" 
                                    Visibility="{Binding EsModoRegistro, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Confirmar Contraseña" Style="{StaticResource FormLabelStyle}"/>
                            <PasswordBox Name="TxtConfirmPassword" PasswordChanged="TxtConfirmPassword_PasswordChanged"/>
                            <TextBlock Name="TxtCoincidenciaPassword" 
                                       Text="{Binding CoincidenciaPasswordTexto}" 
                                       Foreground="{Binding CoincidenciaPasswordColor}" 
                                       Visibility="{Binding CoincidenciaPasswordVisible, Converter={StaticResource BoolToVisConverter}}" 
                                       FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- BOTÓN PRINCIPAL (MÁS CORTO: 180PX) -->
                        <Button Name="BtnAccionPrincipal" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding TextoBotonPrincipal}" 
                                Command="{Binding SubmitCommand}" 
                                Width="180" 
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Viewbox>

        <!-- PANEL FLOTANTE DE CÓDIGO -->
        <controls:OtpNotificationControl />
    </Grid>
</Window>