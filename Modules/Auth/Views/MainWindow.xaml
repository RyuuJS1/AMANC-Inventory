<Window x:Class="AMANC_Inventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AMANC_Inventory.Helpers.Converters"
        Title="AMANC Inventory - Acceso" 
        Height="620" Width="850"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#102240">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <!-- GRID RAÍZ PRINCIPAL -->
    <Grid>
        <!-- VIEWBOX PRINCIPAL: Escala únicamente la interfaz del formulario -->
        <Viewbox Stretch="Uniform">
            <Grid Width="800" Height="620">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ENCABEZADO Y PESTAÑAS -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,25,0,15">
                    <Image Source="pack://application:,,,/Assets/LogoAMANC.png" Width="110" Height="90" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Asociación Mexicana de&#x0a;Ayuda a Niños con Cáncer" FontSize="13" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,0,0,20"/>

                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pestaña Iniciar Sesión -->
                        <Button Name="BtnTabLogin" Grid.Column="0" Command="{Binding SelectTabCommand}" CommandParameter="Login" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Name="TxtTabLogin" Text="Iniciar Sesión" FontSize="14" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#80FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsModoLogin}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Pestaña Crear Cuenta -->
                        <Button Name="BtnTabRegister" Grid.Column="2" Command="{Binding SelectTabCommand}" CommandParameter="Register" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Name="TxtTabRegister" Text="Crear Cuenta" FontSize="14" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#80FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsModoRegistro}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- CONTENIDO DEL FORMULARIO -->
                <Grid Grid.Row="1" Width="300" HorizontalAlignment="Center" Margin="0,10,0,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- Campo Nombre Completo (Solo visible en Modo Registro) -->
                        <StackPanel Name="PanelNombre" Visibility="{Binding EsModoRegistro, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,12">
                            <TextBlock Text="Nombre Completo" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                            <TextBox Name="TxtNombre" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Background="#183059" Foreground="White" BorderBrush="White" BorderThickness="1" Padding="6" CaretBrush="White"/>
                        </StackPanel>

                        <!-- Campo Correo Electrónico (Sin Espacios y Minúsculas) -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Correo Electrónico" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                            <TextBox Name="TxtEmail" 
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#183059" Foreground="White" BorderBrush="White" BorderThickness="1" Padding="6" CaretBrush="White"
                                     PreviewKeyDown="TxtEmail_PreviewKeyDown"
                                     PreviewTextInput="TxtEmail_PreviewTextInput"/>
                        </StackPanel>

                        <!-- Campo Contraseña -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Contraseña" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                            <PasswordBox Name="TxtPassword" Background="#183059" Foreground="White" BorderBrush="White" BorderThickness="1" Padding="6" CaretBrush="White" PasswordChanged="TxtPassword_PasswordChanged"/>

                            <TextBlock Name="TxtNivelSeguridad" Text="{Binding NivelSeguridadTexto}" Foreground="{Binding NivelSeguridadColor}" Visibility="{Binding NivelSeguridadVisible, Converter={StaticResource BoolToVisConverter}}" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <!-- Enlace ¿Olvidaste tu contraseña? (Solo en Modo Login) -->
                            <Button Name="BtnForgotPassword" Content="¿Olvidaste tu contraseña?" Command="{Binding ForgotPasswordCommand}"
                                    Visibility="{Binding EsModoLogin, Converter={StaticResource BoolToVisConverter}}"
                                    Foreground="#80FFFFFF" Background="Transparent" BorderThickness="0" 
                                    FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Campo Confirmar Contraseña (Solo en Modo Registro) -->
                        <StackPanel Name="PanelConfirmarPassword" Visibility="{Binding EsModoRegistro, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,12">
                            <TextBlock Text="Confirmar Contraseña" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                            <PasswordBox Name="TxtConfirmPassword" Background="#183059" Foreground="White" BorderBrush="White" BorderThickness="1" Padding="6" CaretBrush="White" PasswordChanged="TxtConfirmPassword_PasswordChanged"/>
                            <TextBlock Name="TxtCoincidenciaPassword" Text="{Binding CoincidenciaPasswordTexto}" Foreground="{Binding CoincidenciaPasswordColor}" Visibility="{Binding CoincidenciaPasswordVisible, Converter={StaticResource BoolToVisConverter}}" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Botón Principal -->
                    <Button Name="BtnAccionPrincipal" Grid.Row="2" Content="{Binding TextoBotonPrincipal}" Command="{Binding SubmitCommand}" Background="#183059" Foreground="White" FontSize="15" FontWeight="SemiBold" BorderBrush="White" BorderThickness="2" Padding="12,6" Cursor="Hand" HorizontalAlignment="Center" Width="180"/>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- PANEL FLOTANTE DE CÓDIGO -->
        <Border Name="PanelNotificacion" Background="#151515" Width="250" Height="125" 
                HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="0,0,25,25" CornerRadius="8" 
                Visibility="{Binding IsPanelCodigoVisible, Converter={StaticResource BoolToVisConverter}}"
                Panel.ZIndex="99">

            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.5" Direction="270" ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,8,10,0">
                    <TextBlock Text="Introduce Código" Foreground="White" FontWeight="Bold" FontSize="12" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Button Content="✕" Command="{Binding CloseNotificationCommand}" Foreground="#888888" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Cursor="Hand" Padding="4,-2">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,4">
                    <TextBox Name="TxtDigito1" Text="{Binding Digito1, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Width="24" Height="32" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="0,0,0,2" FontSize="16" TextAlignment="Center" Margin="2,0" CaretBrush="White" TextChanged="TxtDigito_TextChanged" PreviewKeyDown="TxtDigito_PreviewKeyDown"/>
                    <TextBox Name="TxtDigito2" Text="{Binding Digito2, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Width="24" Height="32" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="0,0,0,2" FontSize="16" TextAlignment="Center" Margin="2,0" CaretBrush="White" TextChanged="TxtDigito_TextChanged" PreviewKeyDown="TxtDigito_PreviewKeyDown"/>
                    <TextBox Name="TxtDigito3" Text="{Binding Digito3, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Width="24" Height="32" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="0,0,0,2" FontSize="16" TextAlignment="Center" Margin="2,0" CaretBrush="White" TextChanged="TxtDigito_TextChanged" PreviewKeyDown="TxtDigito_PreviewKeyDown"/>
                    <TextBox Name="TxtDigito4" Text="{Binding Digito4, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Width="24" Height="32" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="0,0,0,2" FontSize="16" TextAlignment="Center" Margin="2,0" CaretBrush="White" TextChanged="TxtDigito_TextChanged" PreviewKeyDown="TxtDigito_PreviewKeyDown"/>
                    <TextBox Name="TxtDigito5" Text="{Binding Digito5, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Width="24" Height="32" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="0,0,0,2" FontSize="16" TextAlignment="Center" Margin="2,0" CaretBrush="White" TextChanged="TxtDigito_TextChanged" PreviewKeyDown="TxtDigito_PreviewKeyDown"/>
                    <TextBox Name="TxtDigito6" Text="{Binding Digito6, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Width="24" Height="32" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="0,0,0,2" FontSize="16" TextAlignment="Center" Margin="2,0" CaretBrush="White" TextChanged="TxtDigito_TextChanged" PreviewKeyDown="TxtDigito_PreviewKeyDown"/>
                </StackPanel>

                <TextBlock Name="TxtTiempoRestante" Grid.Row="2" Text="{Binding TiempoRestanteTexto}" 
                           Foreground="#AAAAAA" FontSize="10" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>

                <ProgressBar Name="BarraTiempo" Grid.Row="3" Minimum="0" Maximum="{Binding BarraTiempoMaximo}" Value="{Binding BarraTiempoValor}" Foreground="White" Background="#333333" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>